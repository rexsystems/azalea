AZALEA_JWT_SECRET=change-me-to-a-long-random-string

# Optional stable 64-character hex key for encrypting shared AI provider keys.
# When empty, the encryption key is derived from AZALEA_JWT_SECRET.
AZALEA_AI_ENCRYPTION_KEY=

# Optional: Resend for password-reset emails
RESEND_API_KEY=
AZALEA_MAIL_FROM=Azalea <onboarding@resend.dev>
# Public URL of the self-hosted dashboard (reset links point here)
AZALEA_PUBLIC_WEB_URL=https://azalea.example.com
