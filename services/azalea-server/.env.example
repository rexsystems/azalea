# Required - generate with: openssl rand -hex 32
AZALEA_JWT_SECRET=change-me-to-a-long-random-string
AZALEA_SETUP_SECRET=change-me-setup

# Optional: Resend for password-reset emails
RESEND_API_KEY=
AZALEA_MAIL_FROM=Azalea <onboarding@resend.dev>
# Public URL of azalea-web (reset links point here)
AZALEA_PUBLIC_WEB_URL=https://azalea.example.com
