# Local overrides for desktop builds (not committed). Release defaults: azalea.public.env
# Self-host azalea-server (optional defaults; self-host accounts set their own URL).
AZALEA_API_URL=http://127.0.0.1:9482

# Website used for self-host browser sign-in fallback
AZALEA_WEB_URL=https://azalea.rexsystems.me

# Personal cloud OAuth public client IDs (no secrets - PKCE)
AZALEA_GOOGLE_CLIENT_ID=
AZALEA_MICROSOFT_CLIENT_ID=
AZALEA_DROPBOX_CLIENT_ID=
