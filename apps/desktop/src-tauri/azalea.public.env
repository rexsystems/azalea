# Self-host defaults for local azalea-server (optional; self-host accounts set their own URL).
AZALEA_API_URL=http://127.0.0.1:9482
AZALEA_WEB_URL=http://localhost:3000

# Personal cloud OAuth (public native clients). Leave empty until apps are registered.
# AZALEA_GOOGLE_CLIENT_ID=
# AZALEA_MICROSOFT_CLIENT_ID=
# AZALEA_DROPBOX_CLIENT_ID=
