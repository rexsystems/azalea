{
  "name": "azalea",
  "private": true,
  "version": "0.2.1",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri dev --workspace @azalea/desktop",
    "build": "npm run tauri build --workspace @azalea/desktop -- --no-sign",
    "build:ci": "npm run tauri build --workspace @azalea/desktop",
    "build:linux": "npm run tauri build --workspace @azalea/desktop -- --bundles deb,rpm,appimage --no-sign",
    "build:linux:ci": "npm run tauri build --workspace @azalea/desktop -- --bundles deb,rpm,appimage",
    "build:rpm": "npm run tauri build --workspace @azalea/desktop -- --bundles rpm --no-sign",
    "build:deb": "npm run tauri build --workspace @azalea/desktop -- --bundles deb --no-sign",
    "build:macos": "npm run tauri build --workspace @azalea/desktop -- --bundles app --no-sign",
    "build:macos:ci": "npm run tauri build --workspace @azalea/desktop -- --bundles app",
    "lint": "npm run lint --workspace @azalea/desktop",
    "dev:web": "npm run dev --prefix apps/azalea-server-web",
    "dev:dashboard": "npm run dev --prefix apps/azalea-server-web",
    "build:dashboard": "npm run build --prefix apps/azalea-server-web",
    "test:dashboard": "npm test --prefix apps/azalea-server-web",
    "typecheck": "npm run typecheck --workspace @azalea/desktop",
    "test": "npm test --workspace @azalea/desktop && npm run test:dashboard && node --test .github/tests/*.test.mjs"
  },
  "overrides": {
    "next": "16.3.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0"
  }
}
